#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Win 0
#define Android 1

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // Windows
        //
        // ┌──────────┬──────────┬──────────┐
        // │   BACK   │ WIN+TAB  │ ENCODER  │
        // ├──────────┼──────────┼──────────┤
        // │    ESC   │ COPY     │ PASTE    │
        // ├──────────┼──────────┼──────────┤
        // │  LSHIFT  │ WINDOWS  │ WIN+SH+S │
        // └──────────┴──────────┴──────────┘
        //
        // Encoder:
        //   CW  = Volume Up
        //   CCW = Volume Down
        //
        // Encoder press:
        //   Chuyen sang Android
        // ============================================================

        Windows {
            display-name = "Windows";

            bindings = <
                &kp LA(LEFT)      &kp LG(TAB)      &to Andoird
                &kp ESC           &kp C_AC_COPY    &kp C_AC_PASTE
                &kp LEFT_SHIFT    &kp LGUI         &kp LG(LS(S))
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
            >;
        };

        // ============================================================
        // Android
        //
        // ┌──────────┬──────────┬──────────┐
        // │ BACK     │ HOME     │ ENCODER  │
        // ├──────────┼──────────┼──────────┤
        // │ LSHIFT   │ CTRL+C   │ CTRL+V   │
        // ├──────────┼──────────┼──────────┤
        // │  LCTRL   │ META     │ WIN+SH+S │
        // └──────────┴──────────┴──────────┘
        //
        // Encoder:
        //   CW  = Volume Up
        //   CCW = Volume Down
        //
        // Encoder press:
        //   Quay lai Windows
        // ============================================================

        Android {
            display-name = "Android";

            bindings = <
                &kp C_AC_BACK     &kp C_AC_HOME    &to Win
                &kp LSHIFT        &kp LC(C)        &kp LC(V)
                &kp LCTRL         &kp LMETA        &kp LG(LS(S))
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
            >;
        };
    };
};

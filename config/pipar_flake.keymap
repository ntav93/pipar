#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYOUT_1 0
#define LAYOUT_2 1

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // LAYOUT 1
        //
        // ┌──────────┬──────────┬──────────┐
        // │   BACK   │   MUTE   │ ENCODER  │
        // ├──────────┼──────────┼──────────┤
        // │ LSHIFT   │ CTRL+C   │ CTRL+V   │
        // ├──────────┼──────────┼──────────┤
        // │  LCTRL   │ WINDOWS  │ WIN+SH+S │
        // └──────────┴──────────┴──────────┘
        //
        // Encoder:
        //   CW  = Volume Up
        //   CCW = Volume Down
        //
        // Encoder press:
        //   Chuyen sang Layout 2
        // ============================================================

        layout_1 {
            display-name = "Layout 1";

            bindings = <
                &kp LA(LEFT)      &kp C_MUTE       &to LAYOUT_2
                &kp LSHIFT        &kp LC(C)        &kp LC(V)
                &kp LCTRL         &kp LGUI         &kp LG(LS(S))
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
            >;
        };

        // ============================================================
        // LAYOUT 2
        //
        // ┌──────────┬──────────┬──────────┐
        // │ ESC      │ WIN+TAB  │ ENCODER  │
        // ├──────────┼──────────┼──────────┤
        // │ LSHIFT   │ CTRL+C   │ CTRL+V   │
        // ├──────────┼──────────┼──────────┤
        // │  LCTRL   │ WINDOWS  │ WIN+SH+S │
        // └──────────┴──────────┴──────────┘
        //
        // Encoder:
        //   CW  = Volume Up
        //   CCW = Volume Down
        //
        // Encoder press:
        //   Quay lai Layout 1
        // ============================================================

        layout_2 {
            display-name = "Layout 2";

            bindings = <
                &kp ESC       &kp LG(TAB)       &to LAYOUT_1
                &kp LSHIFT        &kp LC(C)        &kp LC(V)
                &kp LCTRL         &kp LGUI         &kp LG(LS(S))
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
            >;
        };
    };
};
